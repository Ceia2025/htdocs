        {
            "name": "maennchen/zipstream-php",
            "version": "2.4.0",
            "version_normalized": "2.4.0.0",
            "dist": {
                "type": "path",
                "url": "../src/ZipStream-PHP",
                "reference": "3fa72e4c71a43f9e9118752a5c90e476a8dc9eb3"
            },
            "require": {
                "ext-mbstring": "*",
                "myclabs/php-enum": "^1.5",
